    "page number" : 117,
    "bounding box" : [ 90.0, 512.78, 289.443, 523.23 ],
    "font" : "SimSun",
    "font size" : 10.45,
    "text color" : "[0.0, 0.0, 0.0]",
    "content" : "可自定义车灯颜色（如转向时渐变提示）。"
  }, {
    "type" : "paragraph",
