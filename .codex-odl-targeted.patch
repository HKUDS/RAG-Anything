+function ControlledMediaImage({ media, alt, className }) {
+  const directUrl = media && typeof media === 'object'
+    ? (media.data_url || (media.url?.startsWith('data:') ? media.url : ''))
+    : ''
+  const [src, setSrc] = useState(directUrl)
+
+  useEffect(() => {
+    if (directUrl) {
+      setSrc(directUrl)
+      return undefined
+    }
+    const mediaUrl = media && typeof media === 'object' ? media.url : ''
+    const token = getToken()
+    if (!mediaUrl || !token) {
+      setSrc('')
+      return undefined
+    }
+    let active = true
+    let objectUrl = ''
+    fetch(mediaUrl, { headers: { Authorization: `Bearer ${token}` } })
+      .then(res => (res.ok ? res.blob() : null))
+      .then(blob => {
+        if (!active || !blob) return
+        objectUrl = URL.createObjectURL(blob)
+        setSrc(objectUrl)
+      })
+      .catch(() => {
+        if (active) setSrc('')
+      })
+    return () => {
+      active = false
+      if (objectUrl) URL.revokeObjectURL(objectUrl)
+    }
+  }, [directUrl, media])
+
+  if (!src) return null
+  return <img src={src} alt={alt} className={className} loading="lazy" />
+}
