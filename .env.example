# RAG-Anything 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ── 服务器配置 ──
HOST=0.0.0.0
PORT=9621

# ── LLM 配置 ──
# LLM_BINDING_API_KEY=sk-your-api-key-here
# LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BINDING_MODEL=qwen-plus
# TIMEOUT=3600
# MAX_TOKENS=8192

# ── Embedding 配置 ──
# EMBEDDING_BINDING_API_KEY=sk-your-api-key-here
# EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_BINDING_MODEL=text-embedding-v3

# ── JWT 认证配置 ──
# JWT_SECRET=your-jwt-secret-at-least-32-chars
# JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-chars
# JWT_EXPIRY_HOURS=1

# ── 管理员配置 ──
# 重要：首次部署时必须设置强密码，否则系统会生成随机密码并打印到控制台
# DEFAULT_ADMIN_PASSWORD=your-strong-admin-password-here
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_EMAIL=admin@raganything.local

# ── 数据库配置 ──
# AUTH_DB_PATH=./auth.db

# ── CORS 配置 ──
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 工作目录与存储 ──
# WORKING_DIR=./rag_storage
# MAX_UPLOAD_SIZE_MB=500
# MAX_BODY_SIZE_MB=10

# ── 服务进程 ──
# SERVER_WORKERS=4
# BM25_THREAD_WORKERS=4

# ── 日志 ──
# LOG_DIR=./rag_storage/logs
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=10485760  (10MB per file)
# LOG_BACKUP_COUNT=10

# ── 磁盘告警 ──
# DISK_ALERT_THRESHOLD_MB=10240  (10GB)
# DISK_ALERT_PERCENT=85
# DISK_CHECK_INTERVAL=300  (秒)

# ── 查询超时 ──
# LLM_QUERY_TIMEOUT=60  (秒)

# ── 多轮对话 ──
# CONVERSATIONS_FILE=./conversations.json
# CONVERSATION_MAX_ROUNDS=3
# CONVERSATION_MAX_TOKENS=2000
# CONVERSATION_MAX_PER_USER=50

# ── 可观测性 ──
# ENABLE_METRICS=true
# METRICS_PATH=/metrics
