# RAG-Anything 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ── 服务器配置 ──
HOST=0.0.0.0
PORT=9621

# ── LLM 配置 ──
# LLM_BINDING_API_KEY=sk-your-api-key-here
# LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BINDING_MODEL=qwen-plus
# TIMEOUT=3600
# MAX_TOKENS=8192

# ── Embedding 配置 ──
# EMBEDDING_BINDING_API_KEY=sk-your-api-key-here
# EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_BINDING_MODEL=text-embedding-v3

# ── JWT 认证配置 ──
# JWT_SECRET=your-jwt-secret-at-least-32-chars
# JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-chars
# JWT_EXPIRY_HOURS=1

# ── 管理员配置 ──
# 重要：首次部署时必须设置强密码，否则系统会生成随机密码并打印到控制台
# DEFAULT_ADMIN_PASSWORD=your-strong-admin-password-here
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_EMAIL=admin@raganything.local

# ── 数据库配置（生产环境推荐 PostgreSQL，开发环境默认 SQLite）──
# SQLite（默认，零配置）:
# AUTH_DB_PATH=./auth.db

# PostgreSQL（多用户并发，生产环境推荐）:
# DATABASE_URL=postgresql://raganything:your-password@localhost:5432/raganything
# 或分项配置:
# POSTGRES_USER=raganything
# POSTGRES_PASSWORD=your-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=raganything

# ── CORS 配置 ──
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 工作目录与存储 ──
# WORKING_DIR=./rag_storage
# MAX_UPLOAD_SIZE_MB=500
# MAX_BODY_SIZE_MB=10

# ── 服务进程 ──
# SERVER_WORKERS=4
# BM25_THREAD_WORKERS=4

# ── 日志 ──
# LOG_DIR=./rag_storage/logs
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=10485760  (10MB per file)
# LOG_BACKUP_COUNT=10

# ── 磁盘告警 ──
# DISK_ALERT_THRESHOLD_MB=10240  (10GB)
# DISK_ALERT_PERCENT=85
# DISK_CHECK_INTERVAL=300  (秒)

# ── 查询超时 ──
# LLM_QUERY_TIMEOUT=60  (秒)
# AGENT_RETRIEVAL_TIMEOUT=60  (秒，智能体知识库检索总上限)

# ── 多轮对话 ──
# CONVERSATIONS_FILE=./conversations.json
# CONVERSATION_MAX_ROUNDS=10
# CONVERSATION_MAX_TOKENS=2000
# CONVERSATION_MAX_PER_USER=50

# ── 对话摘要压缩（默认启用）──
# CONVERSATION_SUMMARY_ENABLED=true  # 是否启用长对话自动摘要（默认启用）
# CONVERSATION_SUMMARY_TRIGGER_ROUNDS=3  # 触发摘要的最小对话轮数
# CONVERSATION_SUMMARY_MAX_TOKENS=1000  # 摘要注入 Prompt 的最大 token 数
# CONVERSATION_SUMMARY_LLM_MODEL=  # 摘要生成模型（默认使用主 LLM_MODEL）
# CONVERSATION_COMPRESSION_RATIO=0.60  # 目标压缩比（摘要长度/输入长度），不达标会自动重试
# CONVERSATION_COMPRESSION_MAX_RETRIES=2  # 压缩比不达标时的最大重试次数

# ── 上下文分层配置（PromptBuilder）──
# CONVERSATION_CONTEXT_LAYER_CONFIG={"recent_history":{"max_tokens":1500,"enabled":true}}
# 可配置层: user_profile, conversation_summary, image_context, recent_history, retrieval_context

# ── 可观测性 ──
# ENABLE_METRICS=true
# METRICS_PATH=/metrics
