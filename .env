### ============================================
### RAG-Anything 配置文件 - 阿里云千问 (DashScope)
### ============================================

### LLM Configuration -- 千问 DashScope (OpenAI 兼容接口)
LLM_BINDING=openai
LLM_MODEL=qwen-max
VISION_MODEL=qwen-vl-plus
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BINDING_API_KEY=sk-91c6fd261ce54d1284c2320f00a7faad
CHUNK_SIZE=800
CHUNKING_STRATEGY=recursive
ENABLE_LLM_CACHE=false
ENABLE_LLM_CACHE_FOR_EXTRACT=true
TIMEOUT=240
TEMPERATURE=0
MAX_ASYNC=4
LLM_MODEL_MAX_ASYNC=4
MAX_TOKENS=8192

### Embedding Configuration -- 千问 text-embedding-v3
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BINDING_API_KEY=sk-91c6fd261ce54d1284c2320f00a7faad

### Parser Configuration
PARSER=docling
PARSE_METHOD=auto
OUTPUT_DIR=./output

### Multimodal Processing
ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true
ENABLE_EQUATION_PROCESSING=true

### Server Configuration
HOST=0.0.0.0
PORT=9621

### Agentic RAG Configuration
AGENT_MODE=none
AGENT_MAX_STEPS=5
AGENT_TOOL_TIMEOUT=30

### RRF Hybrid Search Configuration (Three-channel fusion retrieval)
RRF_K=60
RRF_ENABLED_CHANNELS=bm25,vector,graph
RRF_CHANNEL_TIMEOUT=10.0

# BM25 keyword channel
BM25_TOP_K=50
BM25_K1=1.5
BM25_B=0.75
BM25_TOKENIZER=jieba

# Vector semantic channel
VECTOR_TOP_K=100

# Knowledge graph channel
GRAPH_TOP_K=30
GRAPH_DEPTH=2

### Language
SUMMARY_LANGUAGE=Chinese

### Authentication
JWT_SECRET=raganything-jwt-secret-change-me-in-production
JWT_EXPIRY_HOURS=24
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@raganything.local
DEFAULT_ADMIN_PASSWORD=admin123

### Storage (default local)
# For production, configure PostgreSQL / Neo4j / Milvus etc.
